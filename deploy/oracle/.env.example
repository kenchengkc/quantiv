# Copy to .env and fill in. On the migration machine this file was generated
# straight from Railway with:
#   railway variables --service quantiv               --json
#   railway variables --service quantiv-quote-worker  --json
# (merged, with RAILWAY_* and PORT stripped). .env is gitignored.
#
# Everything here is EXTERNAL and unchanged by the host move — the VM talks to
# the same Neon / Upstash / R2 as Railway did.

# --- Data backend (Neon Postgres + DuckDB hybrid; keep identical to Railway) ---
DATA_BACKEND=hybrid
DATA_DIR=/data
DUCKDB_PATH=/data/quantiv.duckdb
ENVIRONMENT=production

# --- Neon Postgres (recent forecasts, watchlist) ---
DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require

# --- Upstash Redis (quotes, caches, quote lease) ---
REDIS_URL=rediss://default:PASS@HOST:6379
UPSTASH_REDIS_REST_URL=https://HOST.upstash.io

# --- Cloudflare R2 (LightGBM models + forecasts parquet) ---
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=quantiv-data
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Data providers / auth ---
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
POLYGON_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BACKEND_SHARED_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_URL=https://usequantiv.com

# --- Quote worker tunables (identical to Railway) ---
QUOTE_WORKER_BATCH_WRITES=1
QUOTE_WORKER_ENABLE_WEBSOCKET=1
QUOTE_WORKER_WS_SYMBOLS=50
QUOTE_WORKER_REST_PER_MIN=55
QUOTE_WORKER_QUOTE_FLUSH_S=5
QUOTE_WORKER_LEASE_TTL_S=90
QUOTE_WORKER_STATUS_REFRESH_S=60
QUOTE_WORKER_CURSOR_CHECKPOINT_S=60
QUOTE_WORKER_UNIVERSE_REFRESH_S=300
QUOTE_WORKER_WS_REFRESH_S=120

# --- Caddy TLS (optional overrides; defaults baked into docker-compose.yml) ---
# API_DOMAIN=api.usequantiv.com
# ACME_EMAIL=you@example.com
