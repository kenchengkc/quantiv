{
  "schema": "quantiv.option-quote-quality.v1",
  "market_data_mode": "end_of_day",
  "timestamp_precision": "date",
  "max_quote_date_lag_days": 0,
  "max_quote_time_skew_seconds": 60,
  "max_leg_relative_spread": 0.5,
  "max_straddle_relative_spread": 0.5,
  "max_contract_rejection_rate": 0.65,
  "max_pair_rejection_rate": 0.9,
  "min_upcoming_event_coverage": 0.7,
  "min_horizon_coverage": 0.7,
  "min_bid": 0.01,
  "min_ask": 0.01,
  "min_iv": 0.0001,
  "max_iv": 5.0,
  "min_option_volume_when_available": 1,
  "min_open_interest_when_available": 10,
  "min_dte": 1,
  "max_dte": 60,
  "source_capabilities": {
    "intraday_quote_timestamp": false,
    "option_volume": false,
    "open_interest": false
  },
  "decision_scope": "end_of_day_research",
  "live_trading_eligible": false
}
