# Quantiv Data Files

# Local DB + large data dumps (root-level only, not lib/data/)
/data/
*.csv
*.db
*.sqlite
*.sqlite3
*.parquet
*.duckdb

# Exception: Include essential data files for GitHub Actions.
#
# Caveat: git cannot re-include a file via `!path` when its parent
# directory is excluded (git's .gitignore precedence rule). `/data/`
# above excludes the whole dir, so the `!data/earnings_calendar.csv`
# negation alone is insufficient — `git add data/earnings_calendar.csv`
# will reject the file as ignored. CI works around this with
# `git add -f data/earnings_calendar.csv` (see daily-refresh.yml).
# Any NEW tracked file added under data/ will need the same -f.
#
# The `!data/parquet/` chain below works without -f because it
# re-includes the directory itself first, then the contents.
!data/earnings_calendar.csv
!data/.gitkeep
!data/parquet/
!data/parquet/options_chain/
!data/parquet/options_chain/**/*.parquet

# Always ignore raw downloads
scripts/data/

# ML Models & Training Artifacts (joblib/pickle dirs — not apps/backend/models schemas)
data/models/
apps/backend/data/models/
*.pkl
*.joblib
*.model
*.h5
*.pt
*.pth

# Exception: the serving models in apps/ml/models/ ship with the repo
# so the Railway image (and CI pytest) has them available. They're
# small (~300 KB total for all 6 LightGBM Boosters + metadata + bias
# curves) and stable across the daily-refresh cycle — only retrains
# rewrite them. The broad `*.joblib` rule above still ignores stray
# training outputs anywhere else.
!apps/ml/models/
!apps/ml/models/*.joblib
!apps/ml/models/*.json
!apps/ml/data/bias_curves.parquet

# DuckDB cache and temp files
duckdb-cache/
*.tmp
*.temp

# Training outputs and logs
outputs/
training_logs/
checkpoints/

# If you want to commit a small demo DB, uncomment:
# !data/quantiv_options.db


