# Copy to .env.test.local (gitignored) and fill in values from a Clerk
# DEVELOPMENT instance — never the production one. Test sign-ins create
# real session records on whichever instance these keys point at.

# From the Clerk dashboard → API Keys for the dev instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Email of a user that exists in the dev instance. clerk.signIn() will
# mint a session for this user via the Backend API.
E2E_CLERK_USER_EMAIL=test+e2e@example.com

# Optional overrides — only set if you want Playwright to hit something
# other than localhost:3000.
# E2E_PORT=3000
# E2E_BASE_URL=http://localhost:3000
