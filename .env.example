# =============================================================================
# Quantiv environment template
# -----------------------------------------------------------------------------
# Local dev: copy this file to config/.env.local (Next.js + FastAPI load it
# from config/ via next.config.js and apps/backend/main.py). On Vercel /
# Railway, set the same variables in the provider dashboard instead.
#
#   cp .env.example config/.env.local
# =============================================================================

# --- Frontend (public) -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Clerk (watchlist + auth UI) --------------------------------------------
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Stock quotes (Next.js API routes) --------------------------------------
# Finnhub: https://finnhub.io/register — used by /api/stocks/batch-price,
# /api/cron/refresh-prices, and scripts/sync_finnhub_earnings.py.
# Quote cron paces requests under the free-tier 60 calls/min limit.
FINNHUB_API_KEY=

# Alpaca Market Data — used by /api/cron/refresh-prices for targeted
# extended-hours quotes on today's BMO/AMC earnings reporters. Basic/free
# accounts use the IEX feed through https://data.alpaca.markets.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ENABLE_ALPACA_EXTENDED_QUOTES=0

# Upstash REST — used by batch-price + cron for quote:{symbol} keys.
# Console: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/refresh-prices (Bearer or ?secret=). Generate a random
# string; the Cloudflare Worker in workers/refresh-prices sends the same value.
CRON_SECRET=

# --- Postgres / Neon (optional; shared by several services) ------------------
# When set: Next.js price cron uses it for cursor/metadata; FastAPI uses it as
# the Postgres pool DSN when DATA_BACKEND is postgres or hybrid; watchlist APIs
# can use @neondatabase against the same URL on Vercel.
DATABASE_URL=

# --- FastAPI backend (apps/backend) -----------------------------------------
# postgres | duckdb | hybrid
DATA_BACKEND=duckdb
DATA_DIR=./data
DUCKDB_PATH=./data/quantiv.duckdb

# Optional: only recent days served from Postgres when DATA_BACKEND=hybrid
# HYBRID_LAST_DAYS=1

# If you prefer discrete vars instead of DATABASE_URL for local Postgres:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=quantiv_options

# Redis for FastAPI (redis:// — local Docker or managed TCP, not Upstash REST)
REDIS_URL=redis://localhost:6379

# Polygon: optional live context on POST /api/expected-move (include_live)
POLYGON_API_KEY=

# X-API-Key header for POST /api/admin/refresh-forecasts
ADMIN_API_KEY=

# Allowed CORS origin for custom frontend domain (backend main.py)
# FRONTEND_URL=https://your-domain.com

# --- Optional second Upstash client (lib/cache/redis.ts) ---------------------
# Health / generic cache keys. Often the same REST URL + token as above.
# REDIS_URL=https://your-db.upstash.io
# REDIS_TOKEN=your_rest_token

# --- Runtime hints -----------------------------------------------------------
# ENVIRONMENT=production
# NODE_ENV=production

# --- Cloudflare Worker (workers/refresh-prices) ------------------------------
# Set as Wrangler secrets, not in config/.env.local:
#   REFRESH_URL=https://your-app.vercel.app/api/cron/refresh-prices
#   CRON_SECRET=<same as CRON_SECRET above>
