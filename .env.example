# Frontend
NEXT_PUBLIC_APP_URL=https://quantiv.vercel.app
NEXT_PUBLIC_API_URL=https://quantiv-api.railway.app

# Backend API
DATABASE_URL=postgresql://user:password@host:5432/quantiv_options
REDIS_URL=redis://default:password@redis-host:6379

# API Keys
POLYGON_API_KEY=your_polygon_key_here
FMP_API_KEY=your_fmp_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Upstash Redis — shared cache for /api/stocks/price in prod.
# Get from https://console.upstash.com → create Redis DB → REST API tab.
# Without these the route falls back to per-instance in-memory cache.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Data Configuration
DATA_BACKEND=hybrid
DATA_DIR=/app/data
DUCKDB_PATH=/app/data/quantiv.duckdb

# Optional
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=quantiv_options
SCHEMA=public
