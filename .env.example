# =============================================================================
# Quantiv environment template
# =============================================================================
#
# Local dev:
#   cp .env.example config/.env.local
#
# Next.js and FastAPI load config/.env.local via next.config.js and
# apps/backend/main.py. Never commit config/.env.local.
#
# Where to set variables:
#   [local]    config/.env.local (this file as a starting point)
#   [Vercel]   Project → Environment Variables (Next.js / API routes)
#   [Railway]  Backend service → Variables (FastAPI only)
#   [Wrangler] workers/refresh-prices secrets (see bottom)
#
# Railway setup: docs/RAILWAY_SETUP.md
# =============================================================================

# --- [Vercel + local] Next.js (apps/frontend) ----------------------------------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local-only compatibility: if these E2E names are set instead, the frontend
# dev/build config maps them to the Clerk names above.
# E2E_CLERK_PUBLISHABLE_KEY=
# E2E_CLERK_SECRET_KEY=

# Admin-only operational pages/APIs. Comma-separated Clerk user emails.
# ML_STATUS_ADMIN_EMAILS=you@example.com

# Neon — watchlist APIs + price-cron metadata; same URL as backend when hybrid
DATABASE_URL=

# Finnhub — /api/stocks/batch-price, /api/cron/refresh-prices, sync scripts
FINNHUB_API_KEY=

# Logo.dev — primary ticker logo source (img.logo.dev/ticker/<TICKER>).
# LOGO_DEV_API_KEY is the publishable pk_ key; next.config.js exposes it to the
# client as NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY. The sk_ secret is server-only.
LOGO_DEV_API_KEY=
LOGO_DEV_API_SECRET=

# Optional provider enrichment — data scripts only, not live price polling
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
# Massive is the post-acquisition Polygon API surface. Use the existing
# Polygon key for Massive endpoints; MASSIVE_API_KEY is only a local alias in
# older one-off scripts.
POLYGON_API_KEY=
# API key-pool stacking (optional): add numbered variants to multiply a
# provider's free-tier daily/minute budget. The enrichment runner accounts for
# each key separately and fails over when one is exhausted. Highest value for
# Alpha Vantage (25/day per key is the tightest cap). Up to _8.
# ALPHAVANTAGE_API_KEY_2=
# ALPHAVANTAGE_API_KEY_3=
# FMP_API_KEY_2=
# POLYGON_API_KEY_2=
# TWELVEDATA_API_KEY_2=
FMP_DAILY_CALL_LIMIT=225
ALPHAVANTAGE_DAILY_CALL_LIMIT=25
MASSIVE_MINUTE_CALL_LIMIT=5
PROVIDER_USAGE_LEDGER_PATH=./data/provider_usage_ledger.json

# TwelveData Basic — backend-only OHLCV fallback for realized earnings moves.
# The build publishes only derived realized_move_pct, never raw TwelveData bars.
TWELVEDATA_REALIZED_FALLBACK=1
TWELVEDATA_API_KEY=
TWELVEDATA_DAILY_CREDIT_LIMIT=792
TWELVEDATA_BATCH_SIZE=8
TWELVEDATA_BATCH_DELAY_SEC=61
TWELVEDATA_VALIDATION_SAMPLE_SIZE=8
TWELVEDATA_VALIDATION_DELTA_PCT=0.005
TWELVEDATA_SHARE_PROVIDER_LEDGER=1
# TWELVEDATA_LEDGER_PATH=./data/twelvedata_usage_ledger.json

# Alpaca — extended-hours quotes for today's BMO/AMC reporters (cron only)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ENABLE_ALPACA_EXTENDED_QUOTES=0

# Upstash REST — quote:{symbol} keys in batch-price + cron (not FastAPI REDIS_URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for GET /api/cron/refresh-prices (Worker sends the same value)
CRON_SECRET=

# Vercel only — HMAC proxy to Railway (see docs/HMAC_PROXY.md). Same secret on Railway.
# BACKEND_URL=https://api.usequantiv.com
# BACKEND_SHARED_SECRET=

# --- [Railway + local] FastAPI (apps/backend) ---------------------------------

# postgres | duckdb | hybrid — production Railway uses hybrid + volume at /data
DATA_BACKEND=duckdb
DATA_DIR=./data
DUCKDB_PATH=./data/quantiv.duckdb

# TCP Redis — local Docker or Upstash TLS on Railway (rediss://...:6379)
REDIS_URL=redis://localhost:6379

# Optional — live price context on POST /api/expected-move; also used by
# provider enrichment scripts against Massive/Polygon REST endpoints.
# POLYGON_API_KEY=

# X-API-Key header for POST /api/admin/refresh-forecasts
ADMIN_API_KEY=

# HMAC secret for Vercel → Railway proxy. Same value as Vercel.
# BACKEND_SHARED_SECRET=

# CORS allow-list for your public site (Railway; localhost is built-in)
# FRONTEND_URL=https://usequantiv.com

ENVIRONMENT=development

# R2 lazy fetch for forecasts/models on Railway (optional locally)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quantiv

# When DATA_BACKEND=hybrid, days of recent rows served from Postgres
# HYBRID_LAST_DAYS=1

# Local Docker Postgres only — prefer DATABASE_URL for Neon/hybrid
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=quantiv_options

# --- [local] ML / data scripts (scripts/*, apps/ml/*) -----------------------
# DATA_DIR and DUCKDB_PATH above are shared with the backend.

# Optional — checked by infrastructure/database/validate_env.py
# PARQUET_ROOT=./data/parquet

# --- Playwright E2E ------------------------------------------------------------
# cp apps/frontend/.env.test.local.example → apps/frontend/.env.test.local
# Clerk dev-instance keys + E2E_CLERK_USER_EMAIL (see that file).

# --- Cloudflare Worker (workers/refresh-prices) --------------------------------
# Wrangler secrets (not config/.env.local):
#   REFRESH_URL=https://usequantiv.com/api/cron/refresh-prices
#   CRON_SECRET=<same as CRON_SECRET above>

# --- [Railway] production quick reference --------------------------------------
#   DATA_BACKEND=hybrid
#   DATA_DIR=/data
#   DUCKDB_PATH=/data/quantiv.duckdb
#   DATABASE_URL=<Neon URL>
#   REDIS_URL=rediss://default:...@....upstash.io:6379
#   FRONTEND_URL=https://usequantiv.com
#   ENVIRONMENT=production
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
#   BACKEND_SHARED_SECRET, ADMIN_API_KEY, POLYGON_API_KEY (optional)
#   GitHub Actions weekly model hot-sync: ADMIN_API_KEY and optional RAILWAY_BACKEND_URL
