# Data files (CSVs, Parquet, DuckDB) — not needed for frontend build
# Leading / anchors to repo root only (don't match apps/frontend/lib/data/)
/data/
*.csv
*.parquet
*.duckdb
*.db
*.sqlite
*.sqlite3

# Python virtual env
.venv/
venv/

# ML models and training artifacts
/models/
*.pkl
*.joblib
*.model
*.h5
*.pt

# Python bytecode
__pycache__/
*.py[cod]

# Backend and ML apps (not deployed to Vercel)
apps/backend/
apps/ml/

# Cloudflare Workers (deployed separately via wrangler)
workers/

# Python tools — not needed for frontend build
# NOTE: scripts/ is intentionally kept — the prebuild hook calls
# scripts/materialize_frontend_release.sh and scripts/frontend_release.py.
tools/
lib/

# Project documentation
docs/

# JSON schemas (dev/CI only)
schemas/

# Environment config directory (Vercel uses dashboard env vars)
config/

# Root-level Python / infra files
requirements.txt
railway.toml
railway.worker.toml
.dockerignore

# Dolt data
dolt/

# Git
.git/

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store

# Test artifacts
test-results/
playwright-report/
.pytest_cache/
.ruff_cache/
.mplcache/
.tmp/
coverage/
