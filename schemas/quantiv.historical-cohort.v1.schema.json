{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantiv.dev/schemas/quantiv.historical-cohort.v1.schema.json",
  "title": "Quantiv historical cohort v1",
  "type": "object",
  "required": ["schema", "snapshot_id", "source", "decision_scope", "live_trading_eligible", "live_quote_overlay_included", "evidence_rule", "query", "matching_count", "returned_count", "summary", "events"],
  "properties": {
    "schema": {"const": "quantiv.historical-cohort.v1"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_scope": {"const": "end_of_day_research"},
    "live_trading_eligible": {"const": false},
    "live_quote_overlay_included": {"const": false},
    "evidence_rule": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["public_symbol_payloads", "eligible_event_universe", "forecast_receipt_id", "control_status", "publication_eligible"],
      "properties": {
        "public_symbol_payloads": {"type": "integer", "minimum": 0},
        "eligible_event_universe": {"type": "integer", "minimum": 0},
        "source_as_of_min": {"type": ["string", "null"]},
        "source_as_of_max": {"type": ["string", "null"]},
        "forecast_receipt_id": {"type": ["string", "null"]},
        "control_status": {"type": ["string", "null"]},
        "publication_eligible": {"type": ["boolean", "null"]}
      }
    },
    "query": {"type": "object"},
    "matching_count": {"type": "integer", "minimum": 0},
    "returned_count": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "required": ["events", "symbols", "avgImplied", "avgRealized", "medianImplied", "medianRealized", "medianRatio", "outsideRate", "meanAbsoluteError"]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "date", "timing", "actual", "realized_abs", "implied", "implied_as_of", "implied_quality_status", "edge", "ratio", "outside_implied"],
        "properties": {
          "ticker": {"type": "string"},
          "date": {"type": "string"},
          "actual": {"type": "number"},
          "realized_abs": {"type": "number", "minimum": 0},
          "implied": {"type": "number", "exclusiveMinimum": 0},
          "implied_quality_status": {"const": "decision_eligible_eod"},
          "outside_implied": {"type": "boolean"}
        }
      }
    }
  }
}
