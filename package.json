{
  "name": "quantiv",
  "version": "1.0.0",
  "description": "Quantiv is a modern web platform for options traders to instantly see market-implied moves before earnings. It computes expected moves, greeks, and IV rank from live options chains, with a clean dashboard, historical comparisons, and shareable insights—helping traders act with precision and speed.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "cd apps/backend && python main.py",
    "build": "npm run build --workspace=apps/frontend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "start": "npm run start --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "type-check": "npm run type-check --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/frontend",
    "ml:features": "python apps/ml/feature_engineering.py",
    "ml:train": "python apps/ml/model_trainer.py",
    "ml:walk-forward": "python scripts/research/walk_forward.py",
    "ml:score": "python scripts/daily_score.py",
    "ml:validate": "python scripts/data_healthcheck.py --local",
    "data:sync": "python scripts/sync_dolthub.py",
    "data:sync-full": "python scripts/sync_dolthub.py --full",
    "data:earnings": "python scripts/sync_dolthub.py --earnings",
    "data:earnings:finnhub": "python scripts/sync_finnhub_earnings.py",
    "data:earnings:fmp": "python scripts/sync_fmp_earnings.py",
    "data:earnings:fmp-backfill": "python scripts/backfill_fmp_earnings_by_symbol.py",
    "data:earnings:overrides": "python scripts/apply_earnings_overrides.py --allow-missing",
    "data:fiscal:derive": "python scripts/derive_fiscal_calendar.py --from-calendar",
    "data:profiles:finnhub": "python scripts/sync_finnhub_profiles.py",
    "data:holidays:finnhub": "python scripts/sync_finnhub_market_holidays.py",
    "data:probe:alphavantage-voi": "python scripts/provider_probes/probe_alphavantage_voi.py",
    "data:probe:providers": "python scripts/provider_probes/probe_provider_capabilities.py",
    "data:providers:enrich": "python scripts/sync_provider_enrichments.py",
    "data:ohlcv": "python scripts/sync_dolthub.py --ohlcv",
    "data:csv-parquet": "python scripts/csv_to_parquet.py",
    "data:views": "python scripts/setup_duckdb_from_parquet.py",
    "data:frontend": "python tools/build_frontend_data.py"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "jsdom": "24.1.3",
    "next": "^15.5.18",
    "postcss": "^8.5.26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenchengkc/quantiv.git"
  },
  "keywords": [
    "options",
    "trading",
    "finance",
    "earnings",
    "implied-volatility",
    "greeks"
  ],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/kenchengkc/quantiv/issues"
  },
  "homepage": "https://github.com/kenchengkc/quantiv#readme"
}
